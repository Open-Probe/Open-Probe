#WEB_SEARCH_API_KEY=
#JINA_API_KEY=

# Sonic credential. Takes either a Personal Access Token (issued from the Sonic
# Self-Service Auth Manager at /authmanager/manage-keys) or an Entra OAuth/JWT
# access token — Sonic picks the scheme off the token's shape. A PAT is a
# *testing* credential only; production traffic requires the Entra JWT.
#SONIC_JWT=

# Declares which credential type SONIC_JWT holds: `jwt` (the default) or `pat`.
# Because it defaults to `jwt`, a PAT must be opted into — so a PAT left in a
# production config fails at startup instead of quietly working. The declared mode
# is checked against the token's shape when models are built; a mismatch raises
# before any request is sent. It never changes which header carries the credential
# (always `Authorization: Bearer`).
#SONIC_AUTH_MODE=pat

# Optional Sonic overrides (defaults shown)
#SONIC_BASE_URL=https://your-sonic-host.example.com/v1
#SONIC_PLAN_MODEL=claude-opus-5
#SONIC_COMMON_MODEL=claude-sonnet-5
#SONIC_CODE_MODEL=claude-sonnet-5
#SONIC_GRADER_MODEL=claude-sonnet-5

# Sonic is served off a private internal PKI, which certifi does not carry — so
# httpx cannot validate it by default and every call fails as an opaque
# `APIConnectionError: Connection error.`. Leave this unset on a managed host,
# where `truststore` finds the root in the OS trust store. Set it in containers
# and CI, which usually trust neither: point it at a PEM bundle holding your
# internal roots.
#SONIC_CA_BUNDLE=/etc/ssl/certs/internal-roots.pem
